APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://bpls-runtime.test

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Server-only x-change Partner API configuration. Never expose these through Vite.
XCHANGE_BASE_URL=
XCHANGE_CLIENT_ID=
XCHANGE_CLIENT_SECRET=
XCHANGE_SCOPE="capabilities:read pay-codes:issue pay-codes:pay pay-codes:read"
XCHANGE_TOKEN_REFRESH_LEEWAY_SECONDS=60
XCHANGE_TIMEOUT_SECONDS=15

# Stakeholder Preview / UAT is fail-closed unless every value is explicitly safe.
STAKEHOLDER_PREVIEW_MODE=false
STAKEHOLDER_PREVIEW_PROFILE=
STAKEHOLDER_PREVIEW_DATA_CLASSIFICATION=
STAKEHOLDER_PREVIEW_PII_MODE=
STAKEHOLDER_PREVIEW_PRODUCTION_MIGRATION_ENABLED=true
STAKEHOLDER_PREVIEW_PRODUCTION_INTEGRATIONS=
STAKEHOLDER_PREVIEW_PASSWORD=
STAKEHOLDER_PREVIEW_CITIZEN_EMAIL=stakeholder.preview.citizen@example.test
STAKEHOLDER_PREVIEW_BPLO_EMAIL=stakeholder.preview.bplo@example.test
STAKEHOLDER_PREVIEW_ASSESSMENT_OFFICER_EMAIL=stakeholder.preview.assessment-officer@example.test
STAKEHOLDER_PREVIEW_TREASURY_EMAIL=stakeholder.preview.treasury@example.test
STAKEHOLDER_PREVIEW_CASHIER_EMAIL=stakeholder.preview.cashier@example.test
STAKEHOLDER_PREVIEW_MANAGEMENT_EMAIL=stakeholder.preview.management@example.test
